{# =============================================================================
   Laundry Advisor / Wäschewetter – Kern-Logik (reine Makros, keine Seiteneffekte)
   https://github.com/chlctt/ha-laundry-advisor

   Enthält:
     * Psychrometrie (Magnus, Alduchov–Eskridge b=17.625 c=243.04)
     * drying_score_hour()  – Outdoor-Trocken-Score einer Vorhersagestunde 0..100
     * cellar_eval()        – Keller-Bewertung aus Live-Sensoren (JSON)
     * recommendation()     – Zustands-Entscheidung (JSON)

   Makros, die ein Objekt zurückgeben, liefern JSON-Text → beim Aufruf mit
   `| from_json` weiterverarbeiten.
   ============================================================================= #}

{# ------------------------------------------------------------------ Psychro #}
{%- macro sat_vp(t) -%}
{{ (6.1094 * e ** (17.625 * (t | float(0)) / (243.04 + (t | float(0))))) | round(4) }}
{%- endmacro -%}

{%- macro dew_point(t, rh) -%}
{%- set t = t | float(0) -%}
{%- set rh = [rh | float(0), 0.5] | max -%}
{%- set g = (rh / 100) | log + (17.625 * t) / (243.04 + t) -%}
{{ (243.04 * g / (17.625 - g)) | round(2) }}
{%- endmacro -%}

{%- macro abs_humidity(t, rh) -%}
{%- set t = t | float(0) -%}
{%- set rh = rh | float(0) -%}
{%- set es = 6.1094 * e ** (17.625 * t / (243.04 + t)) -%}
{{ (216.7 * (rh / 100 * es) / (t + 273.15)) | round(2) }}
{%- endmacro -%}

{%- macro vpd(t, rh) -%}
{%- set t = t | float(0) -%}
{%- set rh = rh | float(0) -%}
{%- set es = 6.1094 * e ** (17.625 * t / (243.04 + t)) -%}
{{ (es * (1 - rh / 100)) | round(3) }}
{%- endmacro -%}

{# 0 bei x0, 1 bei x1 (x1 darf < x0 sein für fallende Rampe), geklemmt 0..1 #}
{%- macro _ramp(x, x0, x1) -%}
{%- set x = x | float(0) -%}
{{ [[(x - x0) / (x1 - x0), 0] | max, 1] | min }}
{%- endmacro -%}

{# ------------------------------------------------------- Outdoor-Stundenscore
   Erwartet Klartext-Werte (keine None):
     temp °C, rh %, wind km/h, gust km/h, cloud %, precip mm/h,
     precip_prob % (−1 = unbekannt), irradiance W/m² (−1 = unbekannt)
   weights: [w_wind, w_hum, w_sun, w_temp]  (Summe frei, wird normiert)
   Rückgabe: Score 0..100 (0 = Regen-Gate) #}
{%- macro drying_score_hour(temp, rh, wind, gust, cloud, precip, precip_prob, irradiance, weights) -%}
{%- set temp = temp | float(10) -%}
{%- set rh = rh | float(80) -%}
{%- set wind = wind | float(0) -%}
{%- set gust = gust | float(wind) -%}
{%- set cloud = cloud | float(50) -%}
{%- set precip = precip | float(0) -%}
{%- set pp = precip_prob | float(-1) -%}
{%- set w = weights if weights is iterable and weights is not string else [35, 30, 20, 15] -%}
{%- set wsum = (w[0] + w[1] + w[2] + w[3]) | float(100) -%}

{%- if precip > 0.1 -%}
0
{%- else -%}
  {# --- Wind: 0 @≤3, 1 im Band 12–25, fällt auf 0.3 @40 km/h --- #}
  {%- set s_wind_up = _ramp(wind, 3, 12) | float -%}
  {%- set s_wind_dn = _ramp(wind, 40, 25) | float -%}
  {%- set s_wind = [s_wind_up, s_wind_dn] | min -%}

  {# --- Feuchte: schlechterer Wert aus rF-Rampe und Taupunkt-Spread --- #}
  {%- set td = dew_point(temp, rh) | float -%}
  {%- set spread = temp - td -%}
  {%- set s_rh = _ramp(rh, 90, 55) | float -%}
  {%- set s_spread = _ramp(spread, 2, 6) | float -%}
  {%- set s_hum = [s_rh, s_spread] | min -%}

  {# --- Sonne: aus Einstrahlung (falls da) sonst Bewölkung --- #}
  {%- if irradiance | float(-1) >= 0 -%}
    {%- set s_sun = _ramp(irradiance | float, 20, 450) | float -%}
  {%- else -%}
    {%- set s_sun = (1 - cloud / 100) -%}
  {%- endif -%}

  {# --- Temperatur: 0 @≤5, 1 @≥20 --- #}
  {%- set s_temp = _ramp(temp, 5, 20) | float -%}

  {%- set base = (w[0] * s_wind + w[1] * s_hum + w[2] * s_sun + w[3] * s_temp) / wsum * 100 -%}

  {# --- weiche Multiplikatoren --- #}
  {%- set m_pp = 0.4 if pp > 60 else (0.7 if pp > 40 else 1.0) -%}
  {%- set score = base * m_pp -%}
  {# --- Böen-Deckel --- #}
  {%- set score = [score, 40] | min if gust > 45 else score -%}
  {{ [score, 0] | max | round(1) }}
{%- endif -%}
{%- endmacro -%}

{# ------------------------------------------------------------- Keller-Bewertung
   live_* aus aktuellen Sensoren. wall_t = kälteste Wandtemperatur (−999 = keine).
   Rückgabe JSON:
     {status, humidity, dewpoint_cellar, dewpoint_outdoor, abs_h_cellar,
      abs_h_outdoor, ventilation_useful, surface_rh_estimate, mold_risk} #}
{%- macro cellar_eval(cellar_t, cellar_rh, out_t, out_rh, wall_t, rh_max, t_min, vent_margin) -%}
{%- set cellar_t = cellar_t | float(none) -%}
{%- set cellar_rh = cellar_rh | float(none) -%}
{%- set out_t = out_t | float(none) -%}
{%- set out_rh = out_rh | float(none) -%}
{%- set wall_t = wall_t | float(-999) -%}
{%- set rh_max = rh_max | float(65) -%}
{%- set t_min = t_min | float(15) -%}
{%- set vent_margin = vent_margin | float(5) -%}
{%- if cellar_t is none or cellar_rh is none -%}
{{ {'status': 'unknown'} | to_json }}
{%- else -%}
  {%- set td_c = dew_point(cellar_t, cellar_rh) | float -%}
  {%- set ah_c = abs_humidity(cellar_t, cellar_rh) | float -%}
  {%- set td_o = dew_point(out_t, out_rh) | float if out_t is not none and out_rh is not none else none -%}
  {%- set ah_o = abs_humidity(out_t, out_rh) | float if out_t is not none and out_rh is not none else none -%}
  {%- set vent = (td_o is not none and td_o <= td_c - vent_margin) -%}
  {%- if wall_t > -900 -%}
    {%- set surf_rh = (cellar_rh * sat_vp(cellar_t) | float / (sat_vp(wall_t) | float)) -%}
    {%- set surf_rh = [surf_rh, 100] | min -%}
  {%- else -%}
    {%- set surf_rh = cellar_rh -%}
  {%- endif -%}
  {%- set mold = (surf_rh > 80) or (wall_t > -900 and wall_t <= td_c) -%}
  {%- set status = 'mold_risk' if mold
        else ('too_humid' if cellar_rh > rh_max
        else ('needs_dehumidifier' if not vent
        else 'ok')) -%}
  {{ {
      'status': status,
      'humidity': cellar_rh | round(1),
      'temperature': cellar_t | round(1),
      'dewpoint_cellar': td_c,
      'dewpoint_outdoor': td_o,
      'abs_h_cellar': ah_c,
      'abs_h_outdoor': ah_o,
      'ventilation_useful': vent,
      'surface_rh_estimate': surf_rh | round(1),
      'suitable': (cellar_rh < rh_max and cellar_t >= t_min and not mold),
      'mold_risk': mold
     } | to_json }}
{%- endif -%}
{%- endmacro -%}

{# --------------------------------------------------------------- Empfehlung
   Rückgabe JSON: {state, headline, reasons[]}
   today / tomorrow: Score 0..100 des besten Blocks
   daylight_left_h: verbleibende nutzbare Tageslichtstunden heute
   cellar: das JSON-Objekt aus cellar_eval (| from_json)
   already_washed: bool #}
{%- macro recommendation(today, tomorrow, daylight_left_h, cellar, already_washed,
                         t_hang, t_marginal, wait_delta, smell_ok) -%}
{%- set today = today | float(0) -%}
{%- set tomorrow = tomorrow | float(0) -%}
{%- set dl = daylight_left_h | float(0) -%}
{%- set t_hang = t_hang | float(70) -%}
{%- set t_marg = t_marginal | float(45) -%}
{%- set wd = wait_delta | float(20) -%}
{%- set c = cellar if cellar is mapping else {'status': 'unknown', 'suitable': false, 'mold_risk': false} -%}
{%- set cellar_ok = c.get('suitable', false) -%}
{%- set reasons = namespace(l=[]) -%}

{%- if c.get('mold_risk', false) -%}
  {%- set state = 'mold_risk' -%}
  {%- set reasons.l = ['Kellerbedingungen kritisch (Oberflächenfeuchte / Kondensationsgefahr)'] -%}
{%- elif today >= t_hang and dl >= 4 -%}
  {%- set state = 'hang_outside_now' -%}
  {%- set reasons.l = ['Outdoor-Score heute ' ~ today | round ~ ', genug Tageslicht'] -%}
{%- elif today >= t_hang and dl < 4 -%}
  {%- set state = 'hang_outside_later' -%}
  {%- set reasons.l = ['Gut, aber nur noch ' ~ dl | round(1) ~ ' h Tageslicht – ggf. morgen früh'] -%}
{%- elif today >= 55 and dl >= 3 -%}
  {%- set state = 'outside_marginal' if today < t_hang else 'hang_outside_now' -%}
  {%- set reasons.l = ['Outdoor-Score heute ' ~ today | round ~ ' – geht, beobachten'] -%}
{%- elif tomorrow >= t_hang and (tomorrow - today) >= wd -%}
  {%- if already_washed -%}
    {%- set state = 'wait_for_tomorrow' -%}
    {%- set reasons.l = ['Morgen deutlich besser (' ~ tomorrow | round ~ ' vs ' ~ today | round ~ ') – auf den Ständer, morgen raus'] -%}
  {%- elif not cellar_ok -%}
    {%- set state = 'defer_wash' -%}
    {%- set reasons.l = ['Morgen Top-Wäschetag (' ~ tomorrow | round ~ '), Keller ungünstig – Waschen verschieben'] -%}
  {%- else -%}
    {%- set state = 'cellar_ok' if c.status == 'ok' else 'cellar_dehumidifier' -%}
    {%- set reasons.l = ['Keller nutzbar; morgen wäre draußen besser'] -%}
  {%- endif -%}
{%- elif cellar_ok and c.status == 'ok' -%}
  {%- set state = 'cellar_ok' -%}
  {%- set reasons.l = ['Draußen heute schwach (' ~ today | round ~ '), Keller ok – lüften + Ventilator'] -%}
{%- elif cellar_ok and c.status == 'needs_dehumidifier' -%}
  {%- set state = 'cellar_dehumidifier' -%}
  {%- set reasons.l = ['Keller ok, aber Außenluft nicht trockener – Entfeuchter statt Lüften'] -%}
{%- else -%}
  {%- set state = 'dryer_recommended' -%}
  {%- set reasons.l = ['Weder draußen noch Keller günstig – Trockner / bestbelüfteter Raum'] -%}
{%- endif -%}

{%- set headlines = {
  'hang_outside_now': 'Raus damit – heute trocknet die Wäsche draußen gut.',
  'hang_outside_later': 'Heute noch möglich, aber das Fenster ist knapp.',
  'outside_marginal': 'Draußen geht, aber behalte den Himmel im Auge.',
  'wait_for_tomorrow': 'Heute auf den Ständer – morgen wird es draußen deutlich besser.',
  'defer_wash': 'Mit dem Waschen bis morgen warten lohnt sich.',
  'cellar_ok': 'Ab in den Keller – lüften und Ventilator an.',
  'cellar_dehumidifier': 'Keller ok, aber nur mit Entfeuchter (Lüften bringt nichts).',
  'dryer_recommended': 'Kein guter Trockenort – Wäschetrockner oder bestbelüfteter Raum.',
  'mold_risk': 'Achtung: Keller aktuell zu feucht – nichts Nasses reinhängen.'
} -%}
{{ {'state': state, 'headline': headlines.get(state, ''), 'reasons': reasons.l} | to_json }}
{%- endmacro -%}
